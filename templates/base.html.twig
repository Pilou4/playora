<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Playora{% endblock %}</title>

        {% block metaTag %}
            <meta name="description" content="">
        {% endblock %}
        {% block url %}
            {% set current_route = app.request.attributes.get('_route') %}
            {% if current_route %}
                <link rel="canonical" href="{{ url(current_route, app.request.attributes.get('_route_params', {})) }}">
            {% endif %}
        {% endblock %}

        <meta property="og:site_name" content="Playora">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:type" content="website">
        <meta property="og:title" content="{% block og_title %}Playora{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{% endblock %}">
        <meta property="og:url" content="{{ app.request.uri }}">
        <meta property="og:image" content="{{ absolute_url(asset('images/logo/icone-512.png')) }}">

        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32">
        <link rel="icon" href="{{ asset('images/favicons/favicon.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('images/favicons/apple-touch-icon-180.png') }}">

        {# Le CSS est importé dans assets/app.js ; importmap() ajoute les balises nécessaires #}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="site">
        <a class="skip-link" href="#{% block main_id %}contenu{% endblock %}">Aller au contenu</a>

        {% include '_partials/_header.html.twig' %}

        {% block body %}{% endblock %}

        {% include '_partials/_footer.html.twig' %}
    </body>
</html>
