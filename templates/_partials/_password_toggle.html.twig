{# Bouton œil d'un champ mot de passe ; affiché par assets/js/PasswordToggle.js #}
<button class="field__toggle" type="button" aria-controls="{{ controls }}" aria-pressed="false" hidden>
    <img class="field__toggle-icon field__toggle-icon--open" src="{{ asset('images/icones/oeil-ouvert.svg') }}" width="24" height="24" alt="">
    <img class="field__toggle-icon field__toggle-icon--closed" src="{{ asset('images/icones/oeil-ferme.svg') }}" width="24" height="24" alt="">
