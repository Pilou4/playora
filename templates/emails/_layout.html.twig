{# Mise en page commune des e-mails : styles en ligne, seule façon d'être lu correctement par les messageries #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block subject %}{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background-color:#fff7f2;font-family:Arial,Helvetica,sans-serif;color:#1b2a4a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fff7f2;">
        <tr>
            <td align="center" style="padding:32px 16px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background-color:#ffffff;border-radius:24px;">
                    <tr>
                        <td style="padding:36px 36px 8px;">
                            <img src="{{ absolute_url(asset('images/logo/icone-512.png')) }}" width="56" height="56" alt="Playora" style="display:block;border-radius:14px;">
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:16px 36px 36px;font-size:16px;line-height:1.6;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>
                </table>
                <p style="margin:20px 0 0;font-size:12px;color:#5b6478;">Playora · jeux de cartes en ligne</p>
            </td>
        </tr>
    </table>
</body>
</html>
