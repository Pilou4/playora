{% extends 'base.html.twig' %}

{% block title %}Lien expiré | Playora{% endblock %}

{% block metaTag %}
    <meta name="description" content="Recevez un nouveau lien pour confirmer votre adresse e-mail.">
    <meta name="robots" content="noindex">
{% endblock %}

{% block main_id %}lien-expire{% endblock %}

{% block body %}
    <main id="lien-expire" class="auth">
        <section class="auth__panel auth__panel--message" aria-labelledby="expiration-titre">
            <img class="auth__illustration" src="{{ asset('images/illustrations/expire.svg') }}" width="240" height="200" alt="">
            <h1 id="expiration-titre" class="auth__title">Ce lien a expiré</h1>
            <p class="auth__lead">Pour votre sécurité, un lien n’est valable qu’une heure. Demandez-en un nouveau :</p>

            {% set resend_error = app.flashes('resend_error')|first %}
            <form class="form form--validate" method="post" action="{{ path('app_register_resend') }}" novalidate>
                <div class="field">
                    <label class="field__label" for="renvoi-email">Adresse e-mail</label>
                    <input class="field__input" type="email" id="renvoi-email" name="email" value="{{ email }}" autocomplete="email" aria-describedby="renvoi-email_error" data-required-message="Indiquez votre adresse e-mail." required>
                    <p class="field__error" id="renvoi-email_error"></p>
                </div>

                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">

                <div class="form__message{% if resend_error %} form__message--visible{% endif %}"{% if resend_error %} role="alert"{% endif %}>{{ resend_error }}</div>

                <button class="button button--dark button--large button--block" type="submit">Recevoir un nouveau lien</button>
            </form>
        </section>

        {{ include('_partials/_auth_visual.html.twig', {tagline: 'Plus qu’une étape.', tagline_text: 'Confirmez votre adresse et la partie peut commencer.'}) }}
    </main>
{% endblock %}
