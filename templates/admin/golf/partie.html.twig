{% extends 'admin/_layout.html.twig' %}

{% block title %}Partie n° {{ golf.id }} : Golf | Administration Playora{% endblock %}

{% block admin_id %}partie{% endblock %}

{% block admin_body %}
    {% set room = golf.room %}

    <p class="admin__breadcrumb"><a class="admin__back" href="{{ path('admin_golf_statistics') }}">Statistiques</a> › Partie n° {{ golf.id }}</p>
    <h1 class="admin__title">Partie n° {{ golf.id }}</h1>

    <dl class="admin-stats__grid admin-stats__grid--small">
        {% for item in [
            {label: 'Début', value: room.startedAt ? room.startedAt|date('d/m/Y H:i') : '–'},
            {label: 'Partie en', value: room.targetPoints ~ ' trous'},
            {label: 'Trou', value: golf.hole},
            {label: 'Durée d’un tour', value: room.turnSeconds ~ ' s'},
            {label: 'État', value: room.finishedAt is null ? 'En cours' : (golf.winnerPosition is null ? 'Égalité' : 'Terminée')},
        ] %}
            <div class="admin-stats__item">
                <dt class="admin-stats__label">{{ item.label }}</dt>
                <dd class="admin-stats__value">{{ item.value }}</dd>
            </div>
        {% endfor %}
    </dl>

    <section class="admin-games">
        <h2 class="admin__subtitle" id="joueurs-titre">Joueurs</h2>
        <div class="admin-games__scroll" tabindex="0" role="region" aria-labelledby="joueurs-titre">
            <table class="admin-games__table admin-sortable">
                <thead>
                    <tr>
                        {% for label in ['Place', 'Joueur', 'Points', 'Résultat'] %}
                            <th scope="col"><button class="admin-sort" type="button">{{ label }}<span class="admin-sort__arrow" aria-hidden="true"></span></button></th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for player in players %}
                        <tr>
                            <td>{{ player.position }}</td>
                            <td>{{ include('admin/jeu/_player.html.twig', {player: player}) }}</td>
                            <td data-sort="{{ player.teamScore }}">{{ player.teamScore|number_format(0, ',', ' ') }}</td>
                            <td>{{ player.hasWon is null ? '–' : (player.hasWon ? 'Gagné' : 'Perdu') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin-games">
        <h2 class="admin__subtitle" id="trous-titre">Trous</h2>

        {% if holes is empty %}
            <p class="admin-games__empty">Aucun trou terminé pour l’instant.</p>
        {% else %}
            <div class="admin-games__scroll" tabindex="0" role="region" aria-labelledby="trous-titre">
                <table class="admin-games__table admin-sortable">
                    <thead>
                        <tr>
                            {% for label in ['Trou', 'Donneur', 'Cartes retournées en premier par', 'Points'] %}
                                <th scope="col"><button class="admin-sort" type="button">{{ label }}<span class="admin-sort__arrow" aria-hidden="true"></span></button></th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for hole in holes %}
                            <tr>
                                <td>{{ hole.number }}</td>
                                <td>{{ include('admin/jeu/_player.html.twig', {player: players[hole.dealer + 1] ?? null}) }}</td>
                                <td>{{ include('admin/jeu/_player.html.twig', {player: hole.closer is null ? null : players[hole.closer + 1] ?? null}) }}</td>
                                <td class="admin-games__score">{{ hole.points|join(' – ') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
