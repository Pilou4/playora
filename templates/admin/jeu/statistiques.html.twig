{% extends 'admin/_layout.html.twig' %}

{% block title %}Statistiques : {{ game.label }}{% if page > 1 %} (page {{ page }}){% endif %} | Administration Playora{% endblock %}

{% block admin_id %}statistiques{% endblock %}

{% block admin_body %}
    {% set rate = summary.deals > 0 ? (summary.made * 100 / summary.deals)|round : 0 %}

    <p class="admin__breadcrumb">Jeux › {{ game.label }}</p>
    <h1 class="admin__title">Statistiques de la {{ game.label|lower }}</h1>

    <section class="admin-stats" aria-labelledby="chiffres-titre">
        <h2 class="visually-hidden" id="chiffres-titre">Chiffres généraux</h2>
        <dl class="admin-stats__grid">
            {% for item in [
                {label: 'Parties terminées', value: summary.finished},
                {label: 'Parties en cours', value: summary.playing},
                {label: 'Parties avec robots', value: summary.withBots},
                {label: 'Donnes jouées', value: summary.deals},
                {label: 'Contrats remplis', value: rate ~ ' %'},
                {label: 'Contrats chutés', value: summary.failed},
                {label: 'Litiges', value: summary.litige},
                {label: 'Capots', value: summary.capots},
            ] %}
                <div class="admin-stats__item">
                    <dt class="admin-stats__label">{{ item.label }}</dt>
                    <dd class="admin-stats__value">{{ item.value }}</dd>
                </div>
            {% endfor %}
        </dl>
    </section>

    <section class="admin-games">
        <h2 class="admin__subtitle" id="parties-titre">Parties</h2>

        {% if rows is empty %}
            <p class="admin-games__empty">Aucune partie pour l’instant.</p>
        {% else %}
            <div class="admin-games__scroll" tabindex="0" role="region" aria-labelledby="parties-titre">
                <table class="admin-games__table">
                    <thead>
                        <tr>
                            {# Tri en base : chaque titre est un lien ; un 2e clic inverse l'ordre #}
                            {% for column in [
                                {key: 'numero', label: 'N°'},
                                {key: 'debut', label: 'Début'},
                                {key: 'equipe-1', label: 'Équipe 1'},
                                {key: 'equipe-2', label: 'Équipe 2'},
                                {key: 'score', label: 'Score'},
                                {key: 'donnes', label: 'Donnes'},
                                {key: 'etat', label: 'État'},
                            ] %}
                                {% set active = sort == column.key %}
                                {% set next = active and direction == 'asc' ? 'desc' : 'asc' %}
                                <th scope="col"{% if active %} aria-sort="{{ direction == 'asc' ? 'ascending' : 'descending' }}"{% endif %}>
                                    <a class="admin-sort{% if active %} admin-sort--{{ direction }}{% endif %}" href="{{ path('admin_game_statistics', {game: game.value, tri: column.key, ordre: next}) }}">
                                        {{ column.label }}<span class="admin-sort__arrow" aria-hidden="true"></span>
                                    </a>
                                </th>
                            {% endfor %}
                            <th scope="col"><span class="visually-hidden">Détail</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            {% set belote = row.game %}
                            {% set room = belote.room %}
                            <tr>
                                <td>{{ belote.id }}</td>
                                <td>{{ room.startedAt ? room.startedAt|date('d/m/Y H:i') : '–' }}</td>
                                {% for team in [1, 2] %}
                                    <td>
                                        {% for player in row.players|filter(p => p.team == team) %}
                                            {{- include('admin/jeu/_player.html.twig', {player: player}) }}{% if not loop.last %}, {% endif %}
                                        {%- endfor %}
                                    </td>
                                {% endfor %}
                                <td class="admin-games__score">{{ belote.team1Score }} – {{ belote.team2Score }} <span class="admin-games__target">/ {{ room.targetPoints }}</span></td>
                                <td>{{ row.deals }}</td>
                                <td>
                                    {% if belote.winnerTeam is null %}
                                        <span class="admin-badge admin-badge--playing">En cours</span>
                                    {% else %}
                                        <span class="admin-badge">Gagnée par l’équipe {{ belote.winnerTeam }}</span>
                                    {% endif %}
                                </td>
                                <td><a class="admin-games__link" href="{{ path('admin_game_detail', {game: game.value, id: belote.id}) }}">Détail<span class="visually-hidden"> de la partie {{ belote.id }}</span></a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if pages > 1 %}
                <nav class="admin-pager" aria-label="Pages des parties">
                    {% if page > 1 %}
                        <a class="admin-pager__link" href="{{ path('admin_game_statistics', {game: game.value, page: page - 1, tri: sort, ordre: direction}) }}" rel="prev">Précédentes</a>
                    {% endif %}
                    <span class="admin-pager__current">Page {{ page }} sur {{ pages }}</span>
                    {% if page < pages %}
                        <a class="admin-pager__link" href="{{ path('admin_game_statistics', {game: game.value, page: page + 1, tri: sort, ordre: direction}) }}" rel="next">Suivantes</a>
                    {% endif %}
                </nav>
            {% endif %}
        {% endif %}
    </section>
{% endblock %}
